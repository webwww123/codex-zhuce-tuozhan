{
  "manifest_version": 3,
  "name": "ChatGPT Auto Registration",
  "version": "1.0.0",
  "description": "ChatGPT 注册流程辅助扩展",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://chatgpt.com/*",
    "https://auth.openai.com/*",
    "https://auth0.openai.com/*",
    "https://duckduckgo.com/*",
    "https://mail.google.com/*"
  ],
  "incognito": "spanning",
  "action": {
    "default_title": "打开 ChatGPT 自动注册",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "https://chatgpt.com/*",
        "https://auth.openai.com/*",
        "https://auth0.openai.com/*",
        "https://duckduckgo.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
